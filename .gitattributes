# in pull request diffs (edit scripts/brand/ instead).
assets/brand/identity.html linguist-generated
assets/brand/tokens.css linguist-generated
assets/brand/tokens.json linguist-generated
assets/brand/*.svg linguist-generated
docs/favicon*.svg linguist-generated
docs/tokens.css linguist-generated
