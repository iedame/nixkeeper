# docs/ is the page (GitHub Pages serves it from there), not documentation:
# counted as code, so GitHub sees its JavaScript (language stats, CodeQL).
docs/** linguist-documentation=false

# Kept for reference, not code: the pages the wordmark was chosen from.
assets/brand/explorations/** linguist-documentation

